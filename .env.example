# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Three variables, and that is the whole list as of M1.

# ---------------------------------------------------------------------------
# Base URL — ARCHITECTURE.md §9.1
# ---------------------------------------------------------------------------
# Locally: keep it as localhost. It is what confirmation and password-reset
# emails point at while you develop.
#
# On Vercel: leave it UNSET. The deploy URL is detected from Vercel's own
# system variables, and previews get their own correct URL automatically.
# Never set it to an empty string — set a real URL or omit it. Add it only
# once a custom domain is bought.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Project Settings → Data API
# ---------------------------------------------------------------------------
# The anon key is public by design: it identifies the project, and Row Level
# Security is what actually protects the data. Never put the service_role key
# in a NEXT_PUBLIC_ variable — it bypasses RLS entirely.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# What does NOT belong here
# ---------------------------------------------------------------------------
# Google OAuth client ID and secret — these live in Supabase, under
#   Authentication → Providers → Google.
# The app never sees them; Google redirects to Supabase, and Supabase
# redirects back to us. Google's "Authorised redirect URI" is therefore
#   https://<project-ref>.supabase.co/auth/v1/callback
# and never this app's URL.
#
# Site URL and redirect allowlist — Supabase, under
#   Authentication → URL Configuration.
#
# Coming later: a Jamendo API key in M4 (server-side only, no NEXT_PUBLIC_
# prefix, so it never reaches the browser), and a Sentry DSN.
