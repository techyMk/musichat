# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# The one place the base URL lives (ARCHITECTURE.md §9.1).
#
# OPTIONAL — on Vercel, omit it entirely and the deploy URL is detected
# automatically. Never set it to an empty string: either give it a real
# URL or leave the variable out. Set it once you own a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
